# ─── Redis ───
REDIS_URL=redis://redis:6379/0

# ─── Weaviate ───
WEAVIATE_URL=http://weaviate:8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_API_KEY=
WEAVIATE_COLLECTION_NAME=Documents
WEAVIATE_DISTANCE_METRIC=cosine
WEAVIATE_BATCH_SIZE=128

# ─── Neo4j ───
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# ─── PostgreSQL (users, jobs, extraction drafts, attestations, audit log) ───
POSTGRES_URI=postgresql+psycopg://papercraft:papercraft@postgres:5432/papercraft
DB_ECHO=false

# ─── Object storage (MinIO / S3) ───
# Off by default: uploads live in UPLOAD_DIR unless you turn this on.
OBJECT_STORE_ENABLED=false
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PDFS=papercraft-pdfs
MINIO_REGION=us-east-1

# ─── Auth ───
# CHANGE THIS before exposing the API anywhere: it signs every access token.
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# false = single-player mode; unauthenticated curation is attributed to the
# shared anonymous curator. true = every curation route needs a bearer token.
AUTH_REQUIRED=false

# ─── OpenAlex metadata enrichment ───
OPENALEX_ENABLED=true
OPENALEX_API_URL=https://api.openalex.org
# Supplying an address joins OpenAlex's "polite pool" (better rate limits).
OPENALEX_MAILTO=
OPENALEX_TIMEOUT_S=10

# ─── Extraction + confidence routing ───
# heuristic (default, no LLM cost) | llm | hybrid
EXTRACTION_PROVIDER=heuristic
EXTRACTION_MODEL_VERSION=extraction-v0.2.0
CONFIDENCE_AUTO_INSERT=0.85
CONFIDENCE_DRAFT=0.50
ATTESTATION_PROMOTE_SCORE=2

# ─── LLM (OpenRouter only) ───
# OPENROUTER_API_KEY is optional here: if left unset, the server has no
# default key and every request must supply its own (e.g. entered in the
# frontend header) -- see docs/decisions.md.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
LLM_MODEL=openai/gpt-oss-20b:free

# ─── Embeddings ───
# EMBEDDING_PROVIDER: "local" (sentence-transformers, default) | "openai" | "stub" (tests/dev only)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
# OPENAI_API_KEY=sk-xxxxx   # required only if EMBEDDING_PROVIDER=openai

# ─── RAG ───
RAG_TOP_K=5
MAX_CONTEXT_TOKENS=4096
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# ─── Celery ───
CELERY_CONCURRENCY=2

# ─── Upload ───
MAX_UPLOAD_MB=50
UPLOAD_DIR=/app/uploads
